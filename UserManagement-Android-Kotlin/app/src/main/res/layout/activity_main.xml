<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- BARRA SUPERIOR CON ÍCONO DE CERRAR SESIÓN (Pasos 8 y 10) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCerrarSesionTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cerrar sesión"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- SALUDO DINÁMICO POR HORA -->
        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buenas tardes, Usuario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#222222"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Qué deseas hacer?"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <!-- BOTÓN PAR O IMPAR -->
        <Button
            android:id="@+id/btnParImpar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Ejercicio Par o Impar"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>